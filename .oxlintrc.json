{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["packages/docs/docs/api/**", "packages/docs/build/**", "packages/docs/.docusaurus/**"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["eslint", "typescript", "oxc", "unicorn"],
  "rules": {
    "eslint/no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "plugins": ["eslint", "typescript", "oxc", "unicorn", "jest"]
    }
  ]
}
