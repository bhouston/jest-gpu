{
  "name": "jest-environment-webgpu-node",
  "version": "0.1.0",
  "description": "Jest environment that provides real headless WebGPU (Dawn via the webgpu package) in Node",
  "keywords": [
    "dawn",
    "headless",
    "jest",
    "jest-environment",
    "testing",
    "webgpu"
  ],
  "homepage": "https://github.com/bhouston/jest-gpu#readme",
  "bugs": {
    "url": "https://github.com/bhouston/jest-gpu/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/jest-gpu.git",
    "directory": "packages/jest-environment-webgpu-node"
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.cjs.map",
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "dist/**/*.d.cts",
    "dist/**/*.d.cts.map",
    "dist/**/*.d.mts",
    "dist/**/*.d.mts.map",
    "src/globals.d.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./globals": {
      "types": "./src/globals.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.72",
    "webgpu": "^0.6.1"
  },
  "peerDependencies": {
    "jest": ">=29 <31",
    "jest-environment-node": ">=29 <31"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
